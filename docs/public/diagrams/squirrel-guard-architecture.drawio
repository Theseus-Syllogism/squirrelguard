eometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Detect &amp;amp; track&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;per-frame boxes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="318" y="520" width="232" height="88" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="325" y="553.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Appearance re-ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;OSNet / DINOv2 fingerprints&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="576" y="520" width="232" height="88" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="583" y="553.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Body&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;pose · height · gait · actions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="834" y="520" width="232" height="88" as="geometry"/></mxCell><mxCell id="c49" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="841" y="553.0" width="22" height="22" as="geometry"/></mxCell><mxC