"30" y="1032" width="1594" height="18" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Retention (as configured in the reference deployment)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1F3B57;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="900" height="24" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="136" width="22" height="22" as="geometry"/></mxCell><mxCell id="c7" value="Push-notification cache" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="130" width="400" height="34" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="33.0" height="18" as="geometry"/></mxCell><mxCell id="c9" value="72 hours" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="513.0" y="130" width="360" height="34" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="182" width="22" height="22" as="geometry"/></mxCell><mxCell id="c11" value="Continuous recordings" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="176" width="400" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="184" width="77.0" height="18" as="geometry"/></mxCell><mxCell id="c13" value="7 days (or a 350 GB cap)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="557.0" y="176" width="360" height="34" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="NVR detection clips" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="222" width="400" height="34" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="77.0" height="18" as="geometry"/></mxCell><mxCell id="c17" value="7 days" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="557.0" y="222" width="360" height="34" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="274" width="22" height="22" as="geometry"/></mxCell><mxCell id="c19" value="NVR alert clips" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="268" width="400" height="34" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="276" width="154.0" height="18" as="geometry"/></mxCell><mxCell id="c21" value="14 days" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="634.0" y="268" width="360" height="34" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="22" height="22" as="geometry"/></mxCell><mxCell id="c23" value="Unknown people: sightings, crops, face data" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="314" width="400" height="34" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="322" width="990.0" height="18" as="geometry"/></mxCell><mxCell id="c25" value="90 days" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470.0" y="314" width="360" height="34" as="geometry"/></mxCell><mxCell id="c26" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="366" width="22" height="22" as="geometry"/></mxCell><mxCell id="c27" value="Occupants of non-household vehicles" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="360" width="400" height="34" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="368" width="990.0" height="18" as="geometry"/></mxCell><mxCell id="c29" value="90 days (feature off by default)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470.0" y="360" width="360" height="34" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="22" height="22" as="geometry"/></mxCell><mxCell id="c31" value="3D scenes of a visit" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="406" width="400" height="34" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=30;fillColor=#2E6DA4;strokeColor=none;opacity=85;" vertex="1" parent="1"><mxGeometry x="470" y="414" width="990.0" height="18" as="geometry"/></mxCell><mxCell id="c33" value="follow the sighting (90 days)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470.0" y="406" width="360" height="34" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="30" y="458" width="22" height="22" as="geometry"/></mxCell><mxCell id="c35" value="Enrolled people (with consent)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="62" y="452" width="400" height="34" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;arcSize=30;fillColor=#6B3FA0;strokeColor=none;opacity=35;" vertex="1" parent="1"><mxGeometry x="470" y="460" width="990" height="18" as="geometry"/></mxCell><mxCell id="c37" value="until the person is removed" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#3B1F66;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="482" y="452" width="360" height="34" as="geometry"/></mxCell><mxCell id="c38" value="0 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c39" value="7 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="527.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c40" value="14 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="604.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c41" value="30 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c42" value="60 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c43" value="90 d" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5B6670;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1440.0" y="496" width="40" height="18" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Rules the software enforces&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1F3B57;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="900" height="24" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="780" height="88" as="geometry"/></mxCell><mxCell id="c46" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="46" y="606" width="34" height="34" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Names only for enrolled people&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;A person is named only after the operator enrols them with a consent tick-box. Everyone else is &quot;Unknown #n&quot;.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="96" y="586" width="700" height="76" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="780" height="88" as="geometry"/></mxCell><mxCell id="c49" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="846" y="606" width="34" height="34" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;No outside lookups&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;No face, plate or identity is ever searched in an outside database or service.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="896" y="586" width="700" height="76" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="780" height="88" as="geometry"/></mxCell><mxCell id="c52" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="46" y="706" width="34" height="34" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;No sensitive inference&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;No race or ethnicity anywhere. Age band and gender are shown only as labelled apparent estimates, never used for identity.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="96" y="686" width="700" height="76" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="830" y="680" width="780" height="88" as="geometry"/></mxCell><mxCell id="c55" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="846" y="706" width="34" height="34" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Liveness before trust&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;A face must pass a liveness check before it can mark someone as household (a photo cannot silence alerts).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="896" y="686" width="700" height="76" as="geometry"/></mxCell><mxCell id="c57" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="780" height="88" as="geometry"/></mxCell><mxCell id="c58" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="46" y="806" width="34" height="34" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Enhanced images stay separate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;Enhanced or super-resolved images are labelled ENHANCED and never fed to face or plate recognition.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="96" y="786" width="700" height="76" as="geometry"/></mxCell><mxCell id="c60" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="830" y="780" width="780" height="88" as="geometry"/></mxCell><mxCell id="c61" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="846" y="806" width="34" height="34" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Every decision is explained&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;Each match stores a band, an estimated percent, reason codes and model versions. Gait, height and attributes can shift a band, never decide it.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="896" y="786" width="700" height="76" as="geometry"/></mxCell><mxCell id="c63" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="780" height="88" as="geometry"/></mxCell><mxCell id="c64" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="46" y="906" width="34" height="34" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Alerts only for unknown or watch-listed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;Household and known people never trigger alerts. Actions are always taken by a person.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="96" y="886" width="700" height="76" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;arcSize=6;fillColor=#F7F9FB;strokeColor=#C9D1D9;" vertex="1" parent="1"><mxGeometry x="830" y="880" width="780" height="88" as="geometry"/></mxCell><mxCell id="c67" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="846" y="906" width="34" height="34" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Single sign-on for every page&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6670&quot;&gt;2-factor sign-in for administrators; a restricted group sees only the NVR. Responses are marked private, no-store.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="896" y="886" width="700" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>