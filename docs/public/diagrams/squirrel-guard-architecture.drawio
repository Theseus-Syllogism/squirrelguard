<mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;From camera frame to alert&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#1F3B57;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1594" height="30" as="geometry"/></mxCell><mxCell id="c3" value="One detection event, step by step (animal path on top, people and vehicles below)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5B6670;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1594" height="22" as="geometry"/></mxCell><mxCell id="c4" value="squirrel-guard · public architecture · icons: Lucide (ISC)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5B6670;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="972" width="1594" height="18" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. Camera&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;streams H.264 over RTSP&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#5B6670;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="37" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2. go2rtc relay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;one camera connection, shared&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2E6DA4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="297" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="304" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3. Frigate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;motion → YOLOv8s → tracking → event + clip&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="564" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="571" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;4. MQTT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;frigate/events · frigate/reviews&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2E6DA4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="831" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="838" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;5. Listener&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;fetch snapshot, filter, de-duplicate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1098" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="1105" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;6. Vision check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;local VLM answers one word: squirrel / cat / …&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1365" y="110" width="245" height="92" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="1372" y="145.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;7. Deterrent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;quiet hours + 60 s cooldown → sound on the camera speaker&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#5B6670;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1365" y="300" width="245" height="92" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="1372" y="335.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;8. Publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;squirrelguard/&amp;lt;cam&amp;gt;/event + boxed clip&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D45;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1098" y="300" width="245" height="92" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="1105" y="335.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;9. Bridge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;database row, files, rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2E6DA4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="831" y="300" width="245" height="92" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="838" y="335.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;10. Notify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;push with snapshot, then clip · email&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2E6DA4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="564" y="300" width="245" height="92" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="571" y="335.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;11. Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;SSO → Frigate review, persons UI, dashboards&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2E6DA4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;align=left;spacingLeft=34;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="297" y="300" width="245" height="92" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;" vertex="1" parent="1"><mxGeometry x="304" y="335.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c32" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c15" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B6670;strokeWidth=1.5;fontSize=10;fontColor=#1B1F24;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Not confirmed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5B6670&quot;&gt;logged, no sound, no alert (detector alone is not trusted)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B36B00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;al