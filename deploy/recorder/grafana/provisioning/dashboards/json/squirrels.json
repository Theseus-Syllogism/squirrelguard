   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 9
   },
   "options": {
    "reduceOptions": {
     "values": true,
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "squirrelguard-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT coalesce(verifier, 'verifier offline') AS verdict, count(*) AS n FROM events WHERE camera NOT LIKE '%\\_test' AND lower(label) = 'squirrel' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 2 DESC"
    }
   ],
   "id": 7,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "squirrelguard-pg"
   }
