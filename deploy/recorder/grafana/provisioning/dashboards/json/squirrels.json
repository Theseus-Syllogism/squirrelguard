   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "squirrelguard-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT count(*) AS fired FROM events WHERE camera NOT LIKE '%\\_test' AND action = 'fired' AND $__timeFilter(ts)"
    }
   ],
   "id": 2,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "squirrelguard-pg"
   }
