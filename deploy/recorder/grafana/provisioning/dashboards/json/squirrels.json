     "rawSql": "SELECT ts AS time, camera, label, round(score::numeric, 2) AS score, coalesce(verifier, '-') AS verifier, confirmed, action, detect_ms, snapshot FROM events WHERE camera NOT LIKE '%\\_test' AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
