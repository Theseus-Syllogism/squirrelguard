   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "squirrelguard-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT count(*) AS squirrels FROM events WHERE camera NOT LIKE '%\\_test' AND confirmed AND lower(label) = 'squirrel' AND ts >= date_trunc('day', now() AT TIME ZONE 'America/Denver') AT TIME ZONE 'America/Denver'"
