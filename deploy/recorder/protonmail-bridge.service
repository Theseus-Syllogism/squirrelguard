[Unit]
Description=Proton Mail Bridge (headless) for camstack alert email: SMTP on 127.0.0.1:1025
After=network-online.target
Wants=network-online.target

[Service]
User=protonbridge
Group=protonbridge
Environment=HOME=/var/lib/protonbridge
WorkingDirectory=/var/lib/protonbridge
# headless: no GUI, no CLI prompt; the account is added once with: sudo -u protonbridge -H protonmail-bridge --cli
ExecStart=/usr/bin/protonmail-bridge --noninteractive
Restart=on-failure
RestartSec=20
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
